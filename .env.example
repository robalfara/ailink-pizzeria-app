# Copia este fichero a `.env.local` y rellena los valores.
# `.env.local` está gitignorado: nunca subas credenciales al repo.
#
# Las variables NEXT_PUBLIC_* se incrustan en el bundle en tiempo de BUILD,
# no en runtime. Cada entorno necesita su propio build; no vale promocionar
# el mismo artefacto de desarrollo a producción.

# Dashboard de Supabase -> Project Settings -> Data API -> Project URL
# Sin barra final.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Dashboard de Supabase -> Project Settings -> API Keys -> Publishable key
#
# OJO con el nombre: la variable se llama ..._ANON_KEY porque es el nombre que
# espera @supabase/ssr, pero el valor debe ser la *publishable key*
# (`sb_publishable_...`). Las claves `anon` antiguas (las que empiezan por
# `eyJ`) siguen funcionando, pero Supabase las mantiene solo por compatibilidad.
#
# NUNCA pongas aquí la secret key (`sb_secret_...`): al ser NEXT_PUBLIC_
# acabaría en el navegador de cualquier visitante.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL base sobre la que se construyen los enlaces de confirmación de email.
# En local DEBE ser http://localhost:3000, o los correos de registro te
# mandarán a producción y no podrás completar el alta desde tu máquina.
# En producción: https://www.galarislab.xyz
#
# Este valor tiene que estar dado de alta en el dashboard, en
# Authentication -> URL Configuration -> Redirect URLs (admite varias).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- n8n: gestión de la instancia (scripts/n8n.py) ---
# Mismos nombres que en el repo de CyP, a propósito: un solo patrón por máquina.
# La API key da escritura sobre TODA la instancia. Settings → n8n API → Create an API key.
N8N_API_URL=
N8N_API_KEY=

# --- n8n: aviso saliente desde la app (lib/n8n.ts) ---
# Opcionales: sin ellas notificarN8n() es un no-op silencioso.
# La URL es la Production URL del Webhook node (la Test URL solo escucha
# mientras "Listen for test event" esté activo).
# El secreto viaja en la cabecera x-webhook-secret y tiene que coincidir con la
# credencial Header Auth del nodo. Generar con: openssl rand -base64 32
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

  "cards": [
    {
      "dot": "cyan",
      "title": "Camino web",
      "items": [
        "proxy.ts refresca la cookie en cada petición",
        "lib/dal.ts revalida con getUser(), nunca getSession()",
        "La carta la filtra la policy RLS, no un WHERE del DAL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Camino del chat",
      "items": [
        "El navegador nunca habla con n8n",
        "/api/chat decide el sessionId y guarda el secreto",
        "n8n solo tiene EXECUTE sobre diez funciones"
      ]
    },
    {
      "dot": "rose",
      "title": "La factura",
      "items": [
        "cuota() corre antes del nodo Agent y falla cerrado",
        "activo = false corta el chat, sin desplegar nada",
        "No hay tope de gasto en la consola del proveedor"
      ]
    }
  ]
